datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
}

model ProjectReaction {
  projectId String   @id
  likes     Int      @default(0)
  views     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model SiteVisitor {
  id        String   @id @default(cuid())
  path      String   @default("/")
  createdAt DateTime @default(now())
}

