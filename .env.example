# Database Connection
# For local SQLite development (default zero-config):
DATABASE_URL="file:./dev.db"

# For Production PostgreSQL (e.g. Neon, Supabase, Railway, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/portfolio?sslmode=require"

# Telegram Bot Notifications (Optional - will log to console if not set)
# Create a bot via @BotFather on Telegram to get your token:
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# Your chat ID (message @userinfobot or @myidbot on Telegram to get your ID):
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# GitHub Public API (Optional, to increase rate limit for live stats)
GITHUB_ACCESS_TOKEN=""
GITHUB_USERNAME="hortola"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

